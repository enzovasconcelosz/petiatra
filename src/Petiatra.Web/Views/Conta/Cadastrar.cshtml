@model CadastroVeterinarioViewModel
@{
    ViewData["Title"] = "Cadastrar veterinário";
    Layout = "_LayoutConta";
}
<h1 class="h4 mb-1">Cadastrar veterinário</h1>
<p class="text-secondary">Crie sua conta para acessar o sistema.</p>

<form asp-action="Cadastrar" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label obrigatorio"></label>
        <input asp-for="Nome" class="form-control" autocomplete="name" placeholder="Ex.: Dra. Ana Ribeiro" />
        <span asp-validation-for="Nome"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label obrigatorio"></label>
        <input asp-for="Email" class="form-control" autocomplete="email" inputmode="email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Crmv" class="form-label obrigatorio"></label>
        <input asp-for="Crmv" class="form-control" placeholder="Ex.: CRMV-PR 12345" aria-describedby="ajuda-crmv" />
        <div id="ajuda-crmv" class="form-text">Registro no Conselho Regional de Medicina Veterinária.</div>
        <span asp-validation-for="Crmv"></span>
    </div>
    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="Senha" class="form-label obrigatorio"></label>
            <input asp-for="Senha" class="form-control" autocomplete="new-password" aria-describedby="ajuda-senha" />
            <div id="ajuda-senha" class="form-text">Pelo menos 8 caracteres.</div>
            <span asp-validation-for="Senha"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="ConfirmarSenha" class="form-label obrigatorio"></label>
            <input asp-for="ConfirmarSenha" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmarSenha"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-person-plus" aria-hidden="true"></i> Criar conta</button>
</form>

<p class="text-center mt-3 mb-0">Já tem conta? <a asp-action="Login">Entrar</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
