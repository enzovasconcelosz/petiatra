@model ConsultaFormViewModel
@inject Microsoft.Extensions.Options.IOptions<Petiatra.Web.Services.HorarioFuncionamentoOpcoes> Horario
@{
    var novo = Model.Id == 0;
    ViewData["Title"] = novo ? "Agendar consulta" : "Reagendar consulta";
}
<div class="cabecalho-pagina">
    <div>
        <div class="migalhas"><a asp-action="Index">Consultas</a></div>
        <h1>@ViewData["Title"]</h1>
        <p>O sistema confere o horário de funcionamento e a agenda do veterinário antes de gravar.</p>
    </div>
</div>

<div class="card cartao-formulario">
    <div class="card-body">
        <form asp-action="@(novo ? "Criar" : "Editar")" asp-route-id="@(novo ? null : Model.Id.ToString())" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <partial name="_SeletorBusca" model="@(new SeletorBuscaViewModel(nameof(Model.PetId), "Pet", Url.Action("Pets", "Busca")!, Model.PetId, Model.PetDescricao,
                    "Digite o nome do pet ou do tutor", "Pet novo? Use o Novo atendimento para cadastrar tutor, pet e consulta juntos.", "Selecione o pet."))" />
            </div>

            <div class="mb-3">
                <label asp-for="VeterinarioId" class="form-label obrigatorio"></label>
                <select asp-for="VeterinarioId" class="form-select">
                    <option value="0">Escolha...</option>
                    @foreach (var veterinario in Model.Veterinarios)
                    {
                        <option value="@veterinario.Id">@veterinario.Nome</option>
                    }
                </select>
                <span asp-validation-for="VeterinarioId"></span>
            </div>

            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="Data" class="form-label obrigatorio"></label>
                    <input asp-for="Data" class="form-control" type="date" />
                    <span asp-validation-for="Data"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Hora" class="form-label obrigatorio"></label>
                    <input asp-for="Hora" class="form-control" type="time" aria-describedby="ajuda-hora" />
                    <div id="ajuda-hora" class="form-text">Funcionamento das @Horario.Value.Abertura.ToString("HH:mm") às @Horario.Value.Fechamento.ToString("HH:mm").</div>
                    <span asp-validation-for="Hora"></span>
                </div>
            </div>
            <div class="horarios-ocupados mt-2" data-ocupados data-veterinario="VeterinarioId" data-data="Data" data-ignorar="@(novo ? "" : Model.Id.ToString())" aria-live="polite"></div>

            <div class="mt-3">
                <label asp-for="Motivo" class="form-label obrigatorio"></label>
                <input asp-for="Motivo" class="form-control" placeholder="Ex.: vacinação, check-up, vômitos" />
                <span asp-validation-for="Motivo"></span>
            </div>

            <div class="barra-botoes">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> @(novo ? "Agendar" : "Salvar alterações")</button>
                @if (novo)
                {
                    <button type="submit" name="acao" value="outro" class="btn btn-outline-primary">Agendar e marcar outra</button>
                }
                <a class="btn btn-link" href="@(novo ? Url.Action("Index") : Url.Action("Detalhes", new { id = Model.Id }))">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
