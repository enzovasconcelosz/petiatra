@model IPaginacao
@using Microsoft.AspNetCore.WebUtilities
@{
    string UrlPagina(int numero)
    {
        var query = QueryHelpers.ParseQuery(Context.Request.QueryString.Value);
        query["pagina"] = numero.ToString();
        return Context.Request.Path + QueryString.Create(query).ToUriComponent();
    }
}
<nav class="paginacao" aria-label="Páginas">
    <span class="text-secondary small">
        @Model.TotalItens @(Model.TotalItens == 1 ? "registro" : "registros")
        @if (Model.TotalPaginas > 1)
        {
            <text>· página @Model.Numero de @Model.TotalPaginas</text>
        }
    </span>
    @if (Model.TotalPaginas > 1)
    {
        <div class="btn-group">
            @if (Model.TemAnterior)
            {
                <a class="btn btn-outline-secondary" href="@UrlPagina(Model.Numero - 1)" rel="prev"><i class="bi bi-chevron-left" aria-hidden="true"></i> Anterior</a>
            }
            @if (Model.TemProxima)
            {
                <a class="btn btn-outline-secondary" href="@UrlPagina(Model.Numero + 1)" rel="next">Próxima <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
            }
        </div>
    }
</nav>
