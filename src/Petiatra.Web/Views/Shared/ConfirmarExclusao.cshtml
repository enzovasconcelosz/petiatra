@model ConfirmarExclusaoViewModel
@{
    ViewData["Title"] = Model.Titulo;
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card cartao-confirmacao">
            <div class="card-body p-4">
                <h1 class="h4 d-flex align-items-center gap-2">
                    <i class="bi @(Model.Bloqueada ? "bi-lock" : "bi-trash3") text-danger" aria-hidden="true"></i>
                    @Model.Titulo
                </h1>
                <p class="fs-5 mb-3">@Model.Descricao</p>
                <ul class="lista-avisos">
                    @foreach (var aviso in Model.Avisos)
                    {
                        <li>@aviso</li>
                    }
                </ul>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    @if (!Model.Bloqueada)
                    {
                        <form method="post">
                            <button type="submit" class="btn btn-danger"><i class="bi bi-trash3" aria-hidden="true"></i> Sim, excluir</button>
                        </form>
                    }
                    <a class="btn btn-outline-secondary" href="@Model.UrlVoltar">@(Model.Bloqueada ? "Voltar" : "Não, voltar")</a>
                </div>
            </div>
        </div>
    </div>
</div>
