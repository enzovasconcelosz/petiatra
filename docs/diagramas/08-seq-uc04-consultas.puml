@startuml seq-uc04
!include _estilo.iuml
autonumber
title UC04 - Manter consultas (agendar)
actor "Veterinário" as V
boundary "Consultas/Criar\n(View Razor)" as T
control "ConsultasController" as C
control "ConsultaService" as S
participant "IRegraAgendamento\n(cada regra)" as RG
participant "ConsultaRepositorio" as R
database "AppDbContext\n(EF Core / SQLite)" as DB
V -> T : escolhe pet, veterinário, data/hora e motivo
T -> C : POST /Consultas/Criar (ConsultaFormViewModel)
C -> C : ModelState.IsValid
C -> S : AgendarAsync(dados)
loop para cada regra registrada (RegraHorarioDeFuncionamento, RegraConflitoDeHorario)
  S -> RG : ValidarAsync(consulta)
  opt RegraConflitoDeHorario
    RG -> R : ListarDoVeterinarioNoDiaAsync(veterinarioId, dia)
    R -> DB : SELECT ... WHERE veterinario_id = @id AND status <> 'Cancelada'
    DB --> R : consultas do dia
    R --> RG : lista
    RG -> RG : consulta.ConflitaCom(outra, 30 min)
  end
  RG --> S : Resultado
end
alt todas as regras aprovaram
  S -> R : Adicionar(consulta)
  R -> DB : SaveChangesAsync() -> INSERT INTO consulta
  S --> C : Resultado.Sucesso
  C --> T : RedirectToAction("Index") + "Consulta agendada"
  T --> V : agenda atualizada
else alguma regra recusou (RN01 / RN02)
  S --> C : Resultado.Falha(mensagem da regra)
  C -> C : ModelState.AddModelError(...)
  C --> T : View(model) com os dados digitados
  T --> V : exibe o motivo da recusa
end
note over V, DB : Listar (filtros por data, veterinário e situação), editar, registrar atendimento,\ncancelar e excluir seguem o mesmo caminho: View -> Controller -> Service -> Repositório -> Banco.
@enduml
