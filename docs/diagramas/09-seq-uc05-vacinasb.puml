@startuml seq-uc05b
!include _estilo.iuml
skinparam maxMessageSize 120
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam defaultFontSize 13
autonumber
title UC05 - Manter vacinas (vacinas atrasadas)
actor "Veterinário" as V
boundary "Vacinas\n(Views Razor)" as T
control "VacinasController" as C
control "VacinaService" as S
participant "VacinaRepositorio" as R
database "AppDbContext\n(EF Core / SQLite)" as DB
group Consultar vacinas atrasadas
  V -> T : abre o filtro "Atrasadas"
  T -> C : GET /Vacinas?situacao=Atrasada
  C -> S : ListarAtrasadasAsync()
  S -> R : ListarAtrasadasAsync(hoje)
  R -> DB : SELECT ... WHERE data_reforco < @hoje\nAND NOT EXISTS (dose posterior da mesma vacina)
  DB --> R : vacinas atrasadas (RN07)
  R --> S : lista
  S --> C : lista com pet, tutor e telefone
  C --> T : View(lista)
  T --> V : exibe quem precisa ser avisado
end
@enduml
