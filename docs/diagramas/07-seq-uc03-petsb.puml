@startuml seq-uc03b
!include _estilo.iuml
skinparam maxMessageSize 120
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam defaultFontSize 13
autonumber
title UC03 - Manter pets (ficha e exclusão)
actor "Veterinário" as V
boundary "Pets\n(Views Razor)" as T
control "PetsController" as C
control "PetService" as S
participant "PetRepositorio" as R
database "AppDbContext\n(EF Core / SQLite)" as DB
group Ver ficha do pet
  V -> T : abre o pet
  T -> C : GET /Pets/Detalhes/{id}
  C -> S : ObterFichaAsync(id)
  S -> R : ObterComHistoricoAsync(id)
  R -> DB : SELECT pet + tutor + consultas + vacinas (Include)
  DB --> R : dados
  R --> S : Pet
  S --> C : FichaPetViewModel (idade, situação das vacinas)
  C --> T : View(ficha)
end
group Excluir
  V -> T : confirma a exclusão
  T -> C : POST /Pets/Excluir/{id}
  C -> S : ExcluirAsync(id)
  S -> R : Remover(pet)
  R -> DB : DELETE pet (consultas e vacinas em cascata - RN05)
  S --> C : Resultado.Sucesso
  C --> T : RedirectToAction("Index") + mensagem
end
@enduml
