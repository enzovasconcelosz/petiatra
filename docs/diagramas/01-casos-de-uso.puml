@startuml casos-de-uso
!include _estilo.iuml
left to right direction
title Diagrama de Casos de Uso
actor "Veterinário" as Vet
rectangle "Petiatra" {
  usecase "UC01 - Autenticar-se" as UC01
  usecase "UC02 - Manter tutores" as UC02
  usecase "UC03 - Manter pets" as UC03
  usecase "UC04 - Manter consultas" as UC04
  usecase "UC05 - Manter vacinas" as UC05
  usecase "Cadastrar veterinário" as CV
  usecase "Verificar disponibilidade\ndo veterinário" as VD
  usecase "Consultar vacinas\natrasadas" as VA
}
Vet --> UC01
Vet --> UC02
Vet --> UC03
Vet --> UC04
Vet --> UC05
UC01 <.. CV : <<extend>>
UC04 ..> VD : <<include>>
UC05 <.. VA : <<extend>>
note "Manter = cadastrar, consultar,\neditar e excluir (CRUD)" as N
@enduml
