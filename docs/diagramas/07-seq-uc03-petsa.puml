@startuml seq-uc03a
!include _estilo.iuml
skinparam maxMessageSize 120
skinparam ParticipantPadding 2
skinparam BoxPadding 2
skinparam defaultFontSize 13
autonumber
title UC03 - Manter pets (cadastrar e editar)
actor "Veterinário" as V
boundary "Pets\n(Views Razor)" as T
control "PetsController" as C
control "PetService" as S
participant "PetRepositorio" as R
database "AppDbContext\n(EF Core / SQLite)" as DB
group Cadastrar / editar
  V -> T : informa nome, espécie, sexo e tutor
  T -> C : POST /Pets/Criar (PetFormViewModel)
  C -> S : SalvarAsync(dados)
  S -> S : valida tutor existente e data de nascimento
  alt dados válidos
    S -> R : Adicionar(pet) / Atualizar(pet)
    R -> DB : SaveChangesAsync() -> INSERT / UPDATE
    S --> C : Resultado.Sucesso(id)
    C --> T : RedirectToAction("Detalhes", id)
  else inválidos
    S --> C : Resultado.Falha(mensagem)
    C --> T : View(model) com o erro
  end
end
@enduml
